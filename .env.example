# DeepSeek API 配置
# 1. 复制本文件为 .env：  cp .env.example .env   （Windows 下直接新建 .env 文件复制内容即可）
# 2. 把下面的占位符替换成你的真实密钥
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里云信息查询服务（IQS）联网搜索配置
# API Key 在 IQS 控制台「凭证管理」中创建（不是百炼的 DASHSCOPE_API_KEY）
IQS_API_KEY=your_iqs_api_key_here
IQS_BASE_URL=https://cloud-iqs.aliyuncs.com/search/unified
# 可选：LiteAdvanced（默认）/ GenericAdvanced / Generic / Deep
# IQS_ENGINE_TYPE=LiteAdvanced
